{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "types": ["node"],
        "declaration": true,
        "outDir": "./dist",
        "strict": true,
        "esModuleInterop": true,
        "pretty": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "removeComments": false,
        "noEmit": true
    },
    "exclude": [
        "node_modules",
        "dist"
    ],
    "include": [
        "tsup.config.ts",
        "./src/**/*.ts",
        "./test/**/*.ts"
    ]
}
