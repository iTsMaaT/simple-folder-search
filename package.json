{
  "name": "simple-folder-search",
  "version": "2.3.1",
  "description": "A simple folder search package",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "tsup",
    "code": "git pull && npm i && code . && eslint src",
    "c": "npm run code"
  },
  "author": "iTsMaaT",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iTsMaaT/simple-folder-search.git"
  },
  "bugs": {
    "url": "https://github.com/iTsMaaT/simple-folder-search.git"
  },
  "homepage": "https://github.com/iTsMaaT/simple-folder-search.git",
  "keywords": [
    "folder",
    "file",
    "search",
    "find"
  ],
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "eslint": "^9.17.0",
    "globals": "^15.13.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "fuse.js": "^7.0.0"
  }
}
