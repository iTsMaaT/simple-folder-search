{
  "name": "simple-folder-search",
  "version": "2.4.0",
  "description": "Fuzzy-search files in a folder by name and parent folder name",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "test": "node --import tsx --test test/*.test.ts",
    "build": "tsup",
    "code": "git pull && npm i && code . && eslint src",
    "c": "npm run code",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit -p .",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "author": "iTsMaaT",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iTsMaaT/simple-folder-search.git"
  },
  "bugs": {
    "url": "https://github.com/iTsMaaT/simple-folder-search/issues"
  },
  "homepage": "https://github.com/iTsMaaT/simple-folder-search#readme",
  "keywords": [
    "folder",
    "file",
    "search",
    "find",
    "fuzzy",
    "fuse"
  ],
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "eslint": "^9.17.0",
    "globals": "^15.13.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "fuse.js": "^7.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
